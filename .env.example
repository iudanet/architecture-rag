# ---------- Образ сервиса эмбеддингов ----------
# CPU-вариант Infinity (по умолчанию) — заметно легче, чем :latest с CUDA
EMBED_IMAGE=michaelf34/infinity:latest-cpu

# Альтернатива — Text Embeddings Inference от HuggingFace (образ ~690 МБ).
# Требует другую команду запуска, см. комментарий в docker-compose.yml
# EMBED_IMAGE=ghcr.io/huggingface/text-embeddings-inference:cpu-1.8

# ---------- Эмбеддинги ----------
# Локальный Infinity (по умолчанию, поднимается в docker compose)
EMBED_BASE_URL=http://localhost:7997
# Для локального Infinity ключ не требуется, но переменная нужна для переключения на облачный провайдер
EMBED_API_KEY=not-needed
EMBED_MODEL=deepvk/USER-bge-m3
EMBED_DIM=1024

# Префиксы инструктированных моделей (USER-bge-m3, e5).
# Для облачных эмбеддингов их нужно очистить — см. ниже
EMBED_QUERY_PREFIX="query: "
EMBED_PASSAGE_PREFIX="passage: "

# Лёгкая альтернатива для слабого железа / медленного канала:
# EMBED_MODEL=intfloat/multilingual-e5-small
# EMBED_DIM=384

# ---------- Облачные эмбеддинги вместо локальных ----------
# Раскомментируйте блок целиком. ВАЖНО: после смены модели меняется
# размерность вектора, поэтому индекс нужно пересобрать заново:
#   uv run python scripts/build_index.py --recreate
#
# OpenAI:
# EMBED_BASE_URL=https://api.openai.com/v1
# EMBED_MODEL=text-embedding-3-small
# EMBED_DIM=1536
# EMBED_API_KEY=sk-...
# EMBED_QUERY_PREFIX=
# EMBED_PASSAGE_PREFIX=
#
# Яндекс (модели из того же каталога, что и LLM):
# EMBED_BASE_URL=https://ai.api.cloud.yandex.net/v1
# EMBED_MODEL=emb://<folder_id>/text-search-doc/latest
# EMBED_DIM=256
# EMBED_API_KEY=<тот же ключ, что LLM_API_KEY>
# EMBED_QUERY_PREFIX=
# EMBED_PASSAGE_PREFIX=

# ---------- LLM: раскомментируйте нужный блок ----------

# YandexGPT 5.1 (основной). folder_id указывается дважды: в имени модели
# и отдельной переменной — она уходит заголовком OpenAI-Project.
# Как выпустить ключ — см. README.
LLM_BASE_URL=https://ai.api.cloud.yandex.net/v1
LLM_MODEL=gpt://<folder_id>/yandexgpt-5.1
LLM_API_KEY=
YANDEX_FOLDER_ID=

# Другие модели того же каталога Yandex AI Studio: ключ и folder_id те же,
# меняется только имя модели. Сравнение — в docs/task1-research.md
# LLM_MODEL=gpt://<folder_id>/qwen3-235b-a22b-fp8/latest  # 235B MoE, строже следует CoT, вдвое медленнее
# LLM_MODEL=gpt://<folder_id>/gpt-oss-120b/latest
# LLM_MODEL=gpt://<folder_id>/yandexgpt-5-pro/latest

# OpenAI (при необходимости задайте HTTPS_PROXY)
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=

# DeepSeek
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat
# LLM_API_KEY=

# Ollama — полный офлайн, ключ не нужен
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=gemma4:e2b
# LLM_API_KEY=ollama

# ---------- Прокси (опционально) ----------
# HTTPS_PROXY=http://127.0.0.1:8080

# ---------- Qdrant ----------
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=knowledge_base

# ---------- Поиск ----------
TOP_K=5
SCORE_THRESHOLD=0.45

# ---------- Слои защиты (Задание 5) ----------
SECURITY_INGEST_FILTER=true
SECURITY_RETRIEVE_FILTER=true
SECURITY_PROMPT_GUARD=true
